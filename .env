DB = 'mongodb+srv://localhost/'
PORT = 3000
BASE_URL = 'https://localhost/'
# Session/JWT signing secret. This is a template file others clone as-is —
# a value that "looks random" here is still public. Generate your own with
# `openssl rand -hex 32` before running the server; it refuses to boot on
# a CHANGE_ME value.
COOKIE_KEY = CHANGE_ME_run_openssl_rand_hex_32
COOKIE_KEY2 = CHANGE_ME_run_openssl_rand_hex_32_again
# AES-256-GCM key used to encrypt provider credentials (Telnyx/Twilio API
# keys, SIP passwords) at rest in MongoDB. Must be a 64-character hex string.
CREDENTIALS_ENCRYPTION_KEY = CHANGE_ME_run_openssl_rand_hex_32
SIGNUPS = on
NODE_OPTIONS = --max_old_space_size=460
HTTPS = false

# Put in a random directory name in .env under APPDIRECTORY. Your application will be served only on that subdirectory.
# People will not be able to browse to your app page (by discovering your public github page and deployment link) Example: "voip" -> http://localhost/voip/
# default: 'voip'
APPDIRECTORY = 'voip'